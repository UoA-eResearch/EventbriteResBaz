# EventbriteResBaz CLI environment configuration
# Copy this file to .env and fill in your values.
# Never commit .env to version control.

# ── Eventbrite ────────────────────────────────────────────────────────────────
# Your personal Eventbrite API key.
# Create one at https://www.eventbrite.com/platform/api-keys
EVENTBRITE_API_KEY=your_eventbrite_api_key_here

# The Eventbrite Organisation ID that owns the events.
# Find it in the Eventbrite URL when viewing your organisation dashboard,
# e.g. https://www.eventbrite.com/organizations/1142785580823/overview/
EVENTBRITE_ORG_ID=1142785580823

# The ID of the Eventbrite "template" event that new events are copied from.
# This is the event ID in the Eventbrite URL, e.g. 630562628797
EVENTBRITE_TEMPLATE_ID=630562628797

# ── Google Sheets ─────────────────────────────────────────────────────────────
# The key (spreadsheet ID) of the Google Sheet containing session data.
# Find it in the URL: https://docs.google.com/spreadsheets/d/<SHEET_KEY>/
GOOGLE_SHEET_KEY=1i-emLEb8i30v8ZhCeYpq7uA2v-T81EQaILtIUunERiY

# The name of the worksheet (tab) within the spreadsheet.
GOOGLE_WORKSHEET_NAME=sessions

# Path to your Google service account JSON credentials file.
# See README.md for instructions on creating a service account.
GOOGLE_SERVICE_ACCOUNT_JSON=/path/to/service-account-key.json

# ── ResBaz Schedule ───────────────────────────────────────────────────────────
# URL of the schedule YAML file used to look up session start/end times.
RESBAZ_SCHEDULE_URL=https://raw.githubusercontent.com/UoA-eResearch/resbaz/gh-pages/_data/schedule.yml
